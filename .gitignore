# ====================================================================
# Git Ignore for Machine Learning & Data Science Repository
# ====================================================================

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# --- Trained Models & Pickles (GitHub limits files to 100MB) ---
# similarity.pkl is ~185MB and will be rejected by GitHub without this
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx

# If you ever want to track small demo models, you can un-comment:
# !models/*.pkl
# !pandas/model.pkl

# --- Large Datasets & Archives ---
*.zip
*.tar.gz
*.rar
*.7z

# Generated profiling reports
output.html
*.html

# Large CSVs (Uncomment if you want to exclude big datasets like deliveries.csv)
# deliveries.csv

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Secrets & Environment Variables ---
.env
.env.*
*.env

# --- Operating System & IDE Files ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# VS Code / PyCharm / JetBrains
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
